{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
	    "type": "file", // Ключевой параметр!
	    "source": "~/.config/fastfetch/my-logo.txt", // Путь к вашему файлу
	    "color": { "1": "cyan" },
	    "padding": {
		"top": 1,
		"left": 1
	    }
	},
    "display": {
        "separator": "  ", // Убираем стандартный разделитель ' : '
        "key": {
            "width": 10 // Фиксируем ширину ключей для ровного выравнивания
        },
        "color": {
            "keys": "blue", // Цвет заголовков (ключей)
            "title": "cyan" // Цвет имени пользователя/хоста
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "wm", // Важно: покажет версию i3
        "shell",
        "terminal",
        "cpu",
        "memory",
        "disk",
        "localip",
        "break", // Разрыв строки для отделения логотипа от информации (по желанию)
        "colors"
    ]
}
